[Tests]
  design = 'AutomaticWeakFormAction.md VariationalKernelBase.md'
  issues = '#0000'

  # NOTE: This is a minimal test suite with only tests that have:
  #  1. Existing gold files
  #  2. Known working input files
  #  3. Runtime < 10 seconds
  #
  # Tests using var_diff() that create unwanted split variables are excluded
  # until the Hessian split variable issue is resolved.

  # =============================================================================
  # GRAY-SCOTT REACTION-DIFFUSION
  # =============================================================================

  [gray_scott_auto_short]
    type = 'CSVDiff'
    input = 'gs_auto.i'
    csvdiff = 'gs_auto_out.csv'
    requirement = 'The system shall solve Gray-Scott reaction-diffusion using strong form equations'
    rel_err = 1e-4
    cli_args = 'Executioner/end_time=10'  # Short run for testing
    max_time = 15
  []

  # =============================================================================
  # ALLEN-CAHN PHASE FIELD
  # =============================================================================

  [allen_cahn_anisotropic_short]
    type = 'Exodiff'
    input = 'allen_cahn_anisotropic.i'
    exodiff = 'allen_cahn_anisotropic_out.e'
    requirement = 'The system shall solve Allen-Cahn with anisotropic interface energy'
    rel_err = 1e-4
    cli_args = 'Executioner/end_time=0.5'  # Shortened for testing
    max_parallel = 4
  []

  [allen_cahn_fourfold_short]
    type = 'Exodiff'
    input = 'allen_cahn_fourfold_anisotropy.i'
    exodiff = 'allen_cahn_fourfold_anisotropy_out.e'
    requirement = 'The system shall solve Allen-Cahn with fourfold anisotropy'
    rel_err = 1e-4
    cli_args = 'Executioner/end_time=0.5'  # Shortened for testing
    max_parallel = 4
  []

  # =============================================================================
  # COUPLED SYSTEMS
  # =============================================================================

  [coupled_ch_ac_short]
    type = 'Exodiff'
    input = 'coupled_ch_ac_simple.i'
    exodiff = 'coupled_ch_ac_simple_out.e'
    requirement = 'The system shall solve coupled Cahn-Hilliard and Allen-Cahn'
    rel_err = 1e-4
    cli_args = 'Executioner/end_time=0.5'  # Shortened for testing
  []

  # =============================================================================
  # BOUNDARY CONDITIONS
  # =============================================================================

  [automatic_bcs]
    type = 'Exodiff'
    input = 'automatic_boundary_conditions.i'
    exodiff = 'automatic_boundary_conditions_out.e'
    requirement = 'The system shall generate natural boundary conditions from weak forms'
    rel_err = 1e-5
  []
[]
